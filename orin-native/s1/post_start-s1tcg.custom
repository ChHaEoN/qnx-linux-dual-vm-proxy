# post_start-s1tcg.custom: Phase 3b S1-F TCG rehearsal (s1-design.md §4.2, §6.2-§6.4).
# mkqnximage appends this to the rehearsal host's post_startup.sh. Everything the
# rehearsal does is in /system/bin/s1-host.ksh; the reboot then ends QEMU, which
# runs under -no-reboot.
ksh /system/bin/s1-host.ksh
shutdown -S reboot
