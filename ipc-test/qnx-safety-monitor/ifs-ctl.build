###############################################################################
# ifs-ctl.build -- the A6 guest image for kind 2, the ctl claim (Autoware's
# gate output), beside kind 4 with profile 4, the planning-sim vehicle,
# compiled (SDV Phase 8, WP5). Project source only.
#
# NOT PORTABLE, and not generated: it is ifs-vss-carla.build (the kind 4 image
# of SDV Phase 7, WP4a) with only these changes:
#   the monitor      -> staged from qnx-safety-monitor-ctl, built by
#                       `make ctl` from this worktree's monitor.c
#                       (MONITOR_EXT_KINDS=0x14: kinds 2 and 4) against a
#                       generation's vss_ctl.h, vss_contract.h and
#                       vss_profiles.h; `make ctl` refuses a generation without
#                       kind 4's profile 4 or kind 2's profile 1 before any
#                       compiler runs; named qnx-safety-monitor inside the
#                       image, so every start line runs it, the others in
#                       their unchanged modes
#   two start lines  -> right after the :7161 `stamp` line: TCP 7150 `svc 500`,
#                       the kind 2 claim path with a 500 ms deadline, then
#                       TCP 7151 `stamp`, the same judge with guest stamps and
#                       no deadline (pre-registered timing runs only); each its
#                       own process, as every other start line is
#   build/ifs.build  -> this file, by its path in this worktree
#   build.date       -> output/build/ifs-ctl.build.date, written per build
# Nothing else: the other start lines (:7100, :7101, :7102, :7160 `svc 500`,
# :7161 `stamp`) and every other line below this header are
# ifs-vss-carla.build's, byte for byte (tests/test_ifs_ctl.py pins it). Its own
# monitor binary name for the reason ifs-live.build gives; no other build file
# names it (tests/test_ifs_ctl.py).
# The body's WP11 comments, kept byte for byte, call the binary on the :7160
# and :7161 lines and the staged monitor "the vss build": in this image it is
# the ctl build, which judges kind 4 by the same monitor.c code as the vss
# build (MONITOR_EXT_KINDS's 0x10 bit), against its generation's kind 4
# profiles, profile 4 among them.
# MIXED ROOTS, as in ifs-vss.build: the monitor and build/ifs.build point into
# this worktree (E:/Project/qnx-linux-dual-vm-proxy-sdv-local); every other
# staged file keeps the main checkout's path (E:/Project/qnx-linux-dual-vm-proxy).
# Every file is [+optional] as mkqnximage emits it, so a missing input -- a
# wrong root included -- is skipped SILENTLY and mkifs still exits 0: verify by
# dumpifs, never by exit code.
#
# Build (WP5's image step, after this file's commit; Git Bash, SDP env sourced,
# QNX_TARGET/QNX_HOST/PATH exported), from this worktree's root against its
# head generation, with BUILD_DIR as ifs-vss.build describes it:
#   make -C ipc-test/qnx-safety-monitor ctl
#   BSP=/e/Project/qnx-linux-dual-vm-proxy/qnx-safety-vm/bsp-overlay/aarch64le/boot/sys \
#   BUILD_DIR=qnx-safety-vm \
#   BUILDFILE=E:/Project/qnx-linux-dual-vm-proxy-sdv-local/ipc-test/qnx-safety-monitor/ifs-ctl.build \
#   BUILD_DATE_FILE=output/build/ifs-ctl.build.date OUT=output/ifs-ctl.bin \
#   /usr/bin/bash ipc-test/qnx-dds-monitor/rebuild-ifs-with-dds.sh
# Accept only if, against ifs-vss-carla.bin (check its sha256 against its
# record first; ifs-vss-carla.bin itself is never rebuilt for this),
# compare-ifs.py finds that the only files that differ are qnx-safety-monitor,
# startup-script, build/ifs.build and build.date (each under proc/boot/), none
# is added and none removed, and the startup-script differs by exactly the two
# start lines; and the STAGED qnx-safety-monitor (extracted by dumpifs -x) --
# not the image as a whole, which embeds this file and so always carries the
# phrase -- carries "ctl rules:" and holds the loaded bytes of
# qnx-safety-monitor-ctl. The record names monitor.c's sha256 and commit. At
# its first boot the console's ctl rules: line carries the generation's digest
# and its vss rules: line lists profile 4. sha256 values are kept locally only.
###############################################################################
###############################################################################
#
# IFS Build file
#
###############################################################################

[search=${MKFS_PATH}]

[+dupignore]
[+optional]


[uid=0 gid=0 dperms=0555 perms=0555]

[image=0x40080000]
[virtual=aarch64le,raw ] boot = {
    startup-qemu-virt  
    # Setting PATH and LD_LIBRARY_PATH here allows them to be set both for
    # procnto as well as programs run from the IFS startup script.
    PATH=/proc/boot:/system/bin
    LD_LIBRARY_PATH=/proc/boot:/system/lib:/system/lib/dll
    [+keeplinked uid=0 gid=0 perms=0700 ] CONFIG_PATH=/proc/boot:/system/etc procnto-smp-instr -mr -d 0777 -u 0777  
}

[+script] startup-script = {
    # As various programs expect some binaries in fixed location, create procmgr symlinks to them.
    # We can't specify these paths for the files themselves since if we build a non-union system,
    # the actual paths would be things like /ifs/bin/sh
    procmgr_symlink /proc/boot/ksh /bin/ksh
    procmgr_symlink /proc/boot/ksh /bin/sh
    procmgr_symlink /system/bin/cp /bin/cp
    procmgr_symlink /system/bin/rm /bin/rm
    procmgr_symlink /data/var/tmp /tmp
    procmgr_symlink /system/bin/ssh /usr/bin/ssh
    procmgr_symlink /proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    # **FIXME**
    # Processes should usually use _CS_CONFIG_PATH to locate configuration files.  But for now
    # create symlinks for some locations that can't move.
    procmgr_symlink /system/etc/terminfo /usr/share/terminfo
    procmgr_symlink /data/var/etc /etc
    procmgr_symlink /data/var /var
    procmgr_symlink /system/etc/profile /etc/profile

    TERM=qansi
    HOME=/data/home/root
    #50.builtin
    setconf TIMEZONE UTC0
    mount -uo noexec /dev/shmem
    # ARM Motherboard Express uATX features a PrimeCell PL031 RTC as per:
    # - http://infocenter.arm.com/help/topic/com.arm.doc.dui0447j/Caccaigc.html
    # - http://infocenter.arm.com/help/topic/com.arm.doc.dui0447j/ch04s02s02.html
    rtc -b 0x9010000 primecell
# local/snippets/ifs_start.custom
# Commands executed from ifs start-up script prior to invoking main start-up script or slm
    #~30.builtin
    /proc/boot/startup.sh
# Phase 3b: Safety-side cross-partition monitor. Placed AFTER startup.sh
# returns, because startup.sh is what brings up io-sock and the static
# vtnet0 address -- binding :7100 before that would fail. Kept in the IFS
# on purpose: post_startup.sh lives in the system partition, and editing
# it would mean rewriting disk-qemu, which earlier records depend on.
/proc/boot/qnx-safety-monitor &
# OD12 (2026-09-21): the UDP rungs -- the same two binaries in UDP mode, on
# their own ports so a TCP/UDP mix-up fails instead of answering. Started here,
# after startup.sh has brought io-sock up, like the TCP monitor above.
/proc/boot/qnx-safety-monitor 7101 udp &
/proc/boot/qnx-echo-server-net 7001 udp &
# OD13 (2026-09-23): the VLM service's own monitor instance, TCP 7102. The
# TCP monitor serves one client at a time, so a service client on :7100 would
# stall the latency probe; on its own port it never can.
# OD14 (2026-09-23): in deadline mode -- a claim at least every 2 s, or the
# console says LIVENESS MISS.
/proc/boot/qnx-safety-monitor 7102 svc 2000 &
# WP11 (2026-10-02): kind 4. TCP 7160 is the VSS claim path in deadline mode,
# `svc 500`: a judged claim at least every 500 ms. TCP 7161 is the same judge in
# the stamp mode, the plain TCP loop with no deadline. Both run the vss build.
/proc/boot/qnx-safety-monitor 7160 svc 500 &
/proc/boot/qnx-safety-monitor 7161 stamp &
/proc/boot/qnx-safety-monitor 7150 svc 500 &
/proc/boot/qnx-safety-monitor 7151 stamp &
    #~80.builtin

    display_msg "Startup complete"
    uname -a

    reopen /dev/ser1
}

startup.sh=output/build/startup.sh
mount_fs.sh=output/build/mount_fs.sh

#############################################
### Toybox
#############################################
toybox=usr/bin/toybox
[type=link] cat=toybox
[type=link] chmod=toybox
[type=link] dd=toybox
[type=link] echo=toybox
[type=link] ln=toybox
[type=link] ls=toybox
[type=link] rm=toybox
[type=link] grep=toybox

#############################################
### Utilities
#############################################
bin/on
# waitfor and ability are same binary as on
[type=link] waitfor=on
[type=link] ability=on
sbin/rtc
bin/setfacl
bin/ksh
bin/pidin
# Allow sh to be found in PATH
[type=link] sh=ksh
bin/mount
bin/umount
usr/bin/getconf
# getconf and setconf are same binary
[type=link] setconf=getconf
sbin/devc-serpl011
bin/slog2info


#############################################
### Services
#############################################
sbin/devb-virtio
bin/slogger2
sbin/fsevmgr



#############################################
### Miscellaneous
#############################################
# Capture the build information

[perms=0444] build/options=local/options
[perms=0444] build/options.inc=output/build/from-ifs-demo2/options.inc
[perms=0444] build/ifs.build=E:/Project/qnx-linux-dual-vm-proxy-sdv-local/ipc-test/qnx-safety-monitor/ifs-ctl.build
[perms=0444] build/system.build=output/build/from-ifs-demo2/system.build
[perms=0444] build/data.build=output/build/data.build

[perms=0444] build.date = output/build/ifs-ctl.build.date

#############################################
### Customization
#############################################

[-autolink]

lib/libc.so.6
usr/lib/ldqnx-64.so.2
lib/libgcc_s.so.1
lib/libm.so.3
lib/libcam.so.2
lib/dll/io-blk.so
lib/dll/cam-disk.so
lib/dll/fs-qnx6.so
lib/dll/fs-dos.so
lib/libslog2.so.1
[type=link] libslog2.so=libslog2.so.1
usr/lib/libcrypto.so.3
lib/libsocket.so.4
[type=link] libsocket.so=libsocket.so.4
usr/lib/libz.so.2
lib/libslog2shim.so.1
lib/libsecpol.so.1
lib/libpci.so.3.0
lib/libjson.so.1
lib/libslog2parse.so.1
lib/libjail.so.1
lib/libfsnotify.so.1


usr/lib/libqcrypto.so.1.0
lib/dll/qcrypto-openssl-3.so
lib/libqh.so.1
lib/libregex.so.1

[uid=0 gid=0 perms=0444] qcrypto.conf={
openssl-3 tags=*
}
# local/snippets/ifs_files.custom
# Placeholder for local list of files to add to ifs
#
# Phase 3 (Orin, docs/orin-port.md): stage the QNX-guest TCP echo server so
# scripts/orin's post_start.custom can start it as /proc/boot/qnx-echo-server-net.
# Mirrors scripts/qhv's guest ifs_files.custom staging (build-qhv.bat) for the
# Phase-2 qnx-echo-server; same [perms=555] name=abs-path mkqnximage syntax.
[perms=555] qnx-echo-server-net=E:/Project/qnx-linux-dual-vm-proxy/ipc-test/qnx-server-net/qnx-echo-server-net
# WP11 (2026-10-02): the vss build of monitor.c (kind 4 beside the deadline mode),
# under its own host name, from THIS worktree; every other staged file keeps M's root.
[perms=555] qnx-safety-monitor=E:/Project/qnx-linux-dual-vm-proxy-sdv-local/ipc-test/qnx-safety-monitor/qnx-safety-monitor-ctl
#############################################
### QTD
#############################################
qtd_public_key.pem=local/misc_files/qtd_public_key.pem
fs-qtd.so=lib/dll/fs-qtd.so
