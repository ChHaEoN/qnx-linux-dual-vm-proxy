<!-- L4T (Compute) side. Bind to br0 and use unicast peers.

     WHY NOT THE DEFAULT. Cyclone picks ONE interface by priority, and on a
     board with lo, a wireless interface, docker0 and br0 that need not be br0.
     DDS traffic would then never reach the QNX guest, and nothing would say so.

     WHY UNICAST. Default SPDP is multicast 239.255.0.1. A Linux bridge enables
     IGMP snooping with mcast_querier disabled by default, so group state over
     br0/tap is unreliable. Explicit peers remove the dependency. Configure BOTH
     sides: a one-sided peer list converges slowly (asymmetrical discovery). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="br0" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <!-- auto, NOT a fixed index. With a fixed ParticipantIndex, a second
           process on this host takes the same index as the first, and the two
           can fail to communicate without an error. The Compute side normally
           runs more than one process, so a fixed index is a latent trap, not a
           simplification. -->
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>10</MaxAutoParticipantIndex>
      <Peers>
        <Peer Address="192.168.100.10"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
