# SUPERSEDED 2026-07-28: this was the milestone-1 gate-pass PROPOSAL only.
# /dev/qhv/con1 below is not a device the built image provides -- the config
# gate checks that a DIRECTIVE's syntax is allowed, not that its path is real.
# The config in use (hostdev /dev/ptyp0, a devc-pty master on this image) is
# what scripts/qhv/post_start.custom generates; see qnx-host-client/README.md.
# Kept here only as a record of the milestone-1 proposal, not as something to
# copy from.
system mkqnximage-guest
ram 0x80000000,512M
cpu
load /data/hypervisor/guest/ifs.bin
vdev pl011
 hostdev >-
 loc 0x1c090000
 intr gic:37
vdev virtio-console
 loc 0x20000000
 intr gic:42
 hostdev /dev/qhv/con1
vdev virtio-blk
 loc 0x1c0d0000
 intr gic:41
 hostdev /dev/qvmdisk0
 name vblk0
