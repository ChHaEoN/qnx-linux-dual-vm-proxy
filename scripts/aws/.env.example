# Copy to scripts/aws/.env.local (gitignored) and fill in. drive-metal.sh sources it.
# Nothing here is a secret by itself, but it names this account's resources, so it
# stays out of the repo.
#
# NOT KEPT HERE: METAL_QEMU_PKG, the qemu-system-arm version a session expects (the other
# host's on the day, as its dpkg-query prints it, epoch included). Export it for the
# session, as a session's own METAL_REPO_TAR is passed: a value left in this file would be
# the last session's. `launch` refuses one that is not a package version, and `run setup`
# refuses a host whose package differs. Unset, nothing is expected.
METAL_KEY_NAME=your-ec2-key-pair-name
METAL_PEM=$HOME/.ssh/your-key.pem
METAL_SG_NAME=a-security-group-admitting-your-address-on-22
# METAL_REGION=eu-central-1
# METAL_AMI=ami-xxxxxxxxxxxxxxxxx                # region-local: a new METAL_REGION needs a new id.
#                                                # The default is an eu-central-1 Ubuntu 24.04 arm64 one.
# METAL_TYPE=c7g.metal                           # the default (2026-10-17); a1.metal, the earlier one, still works
# METAL_STATE=$HOME/.cache/qnx-metal-session     # instance id and address; outside the repo
# METAL_FETCH_DIR=/where/fetch/unpacks/pub.tgz   # default <METAL_STATE>/fetched; refused inside the repo
METAL_REPO_TAR=/path/to/repo.tar                  # git archive HEAD -- orin-native/gpu-concurrency ipc-test scripts/setup-bridge.sh
                                                  # (a liveness session also needs orin-native/edge-llm; a vss
                                                  # session, archived in Git Bash, needs sdv too:
                                                  #   git archive <commit> -- orin-native/gpu-concurrency ipc-test scripts/setup-bridge.sh sdv
                                                  # and the harness phase refuses a vss harness without sdv/stack/step3.py)
METAL_IFS=/path/to/ifs-kick.bin                   # QNX-derived: never commit it (ifs-live.bin for a liveness session,
                                                  # ifs-vss.bin for a vss session)
METAL_DISK_GZ=/path/to/disk-qemu.gz
# METAL_IFS_EXTRA="/path/a.bin /path/b.bin"       # a harness session's other images
# METAL_FILES="/path/bundle.json /path/sdv-arm64-images.tar"   # a vss session's bundle files, to ~/a1/in; setup checks each
                                                  # (bundle.json's commit must be the tarball's, or upload refuses)
# METAL_VOLUME_SIZE=32                            # the root volume, whole GiB from 16 to 64 (default 16); vss sessions use 32
