# post_start.custom — appended to the QHV host's post_startup.sh by mkqnximage.
#
# build-qhv.bat pre-places this into <host-build-dir>/local/snippets/ BEFORE the
# host build so mkqnximage bakes it in (mkqnximage only seeds a default here if
# one is not already present, so ours wins).
#
# It auto-starts the QNX guest under QVM with a NO-NETWORK config, because:
#   - the stock /data/hypervisor/start_guest wires a virtio-net peer that needs
#     the host io-sock stack, and the image expects virtio-net + virtio-rng at
#     fixed virtio-mmio slots (ADR-002 RQ-4; findings.md 2026-07-28), which the
#     launch line launch-qhv-tcg.ps1 uses by default does not present
#     (-WithRng / WITH_RNG=1 does). This snippet keeps the guest no-net
#     regardless, because the benchmark does not need it; and
#   - it runs unattended, rather than driving `qvm` interactively over the slow
#     TCG serial console.
# Networking is not needed to demonstrate QHV hosting a guest; console + blk are.
#
# (2026-07-28, ipc-test/qnx-host-client/README.md) The virtio-console vdev is
# given a `hostdev` binding. /dev/ptyp0 is a devc-pty master (devc-pty is
# already running on this image); qvm opens that end itself, so the paired
# slave /dev/ttyp0 is
# the endpoint the HOST-side qnx-host-client opens below. qvm is launched in
# the background (not foreground) so this script can go on to run the client
# after a fixed boot-grace sleep -- there is no ready signal from the guest,
# only a wait for the local /dev/ttyp0 node plus a grace period long enough
# for the guest's own devc-virtio + qnx-echo-server startup (see
# scripts/qhv/guest-post_start.custom) to have bound its end.
echo "=== AUTO-START QNX GUEST UNDER QVM (no-net) ==="
devb-loopback loopback blksz=512,prefix=qvmdisk,fd=/data/hypervisor/guest/disk-qvm
waitfor /dev/qvmdisk0 10
printf 'system mkqnximage-guest\nram 0x80000000,512M\ncpu\nload /data/hypervisor/guest/ifs.bin\nvdev pl011\n hostdev >-\n loc 0x1c090000\n intr gic:37\nvdev virtio-console\n loc 0x20000000\n intr gic:42\n hostdev /dev/ptyp0\nvdev virtio-blk\n loc 0x1c0d0000\n intr gic:41\n hostdev /dev/qvmdisk0\n name vblk0\n' > /data/hypervisor/guest/g2.conf
echo "=== launching qvm @g2.conf (background) ==="
qvm @/data/hypervisor/guest/g2.conf &

waitfor /dev/ttyp0 10
echo "=== boot-grace sleep for guest devc-virtio + qnx-echo-server startup ==="
sleep 90
if [ -x /data/hypervisor/qnx-host-client ]; then
  echo "=== running qnx-host-client (mechanism-alive IPC benchmark, TCG-bound) ==="
  # 15 iterations after 5 warm-up, NOT the DEFAULT_ITERS=100000/
  # DEFAULT_WARMUP=1000 the binary otherwise uses with no args: a deliberate
  # choice for this leg (2026-07-28; the reasons are held locally, NC QDL v7
  # 4.6(i)). Change it only as a deliberate, reviewed choice.
  /data/hypervisor/qnx-host-client 15 /dev/ttyp0 5
  echo "=== qnx-host-client exit=$? ==="
else
  echo "post_start.custom: /data/hypervisor/qnx-host-client not staged; skipping benchmark"
fi
