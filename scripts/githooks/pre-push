#!/bin/sh
# pre-push -- stop a push that would publish a measured or functional result.
#
# NC QDL v7 clause 4.6(i): measurement results stay local (owner, 2026-09-27).
# This runs scripts/ci/results_guard.py on exactly what is about to be pushed,
# before it leaves the machine. The claims-gate workflow runs the same check
# after a push, when the commits are already public: this hook is the one that
# prevents, the workflow only reports.
#
# Install once per clone:   git config core.hooksPath scripts/githooks
# It checks, for each ref pushed: the output paths in the tree, figures the
# guarded text gains against what the remote has, and figures in the messages of
# the commits being pushed.

remote="$1"
zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel) || exit 1

py=""
for c in python3 python; do
	if "$c" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
		py=$c
		break
	fi
done
if [ -z "$py" ]; then
	echo "pre-push: no Python 3 found, so results_guard.py could not run; refusing the push" >&2
	exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue   # deleting a ref publishes nothing
	if [ "$remote_sha" = "$zero" ]; then
		# A new ref: compare with what the remote's main already has.
		base=$(git merge-base "$local_sha" "refs/remotes/$remote/main" 2>/dev/null) || base=""
	else
		base=$remote_sha
	fi
	echo "pre-push: results_guard on $local_ref" >&2
	if [ -n "$base" ]; then
		"$py" "$root/scripts/ci/results_guard.py" --repo "$root" --rev "$local_sha" \
			--base "$base" --commits "$base..$local_sha" >&2 || status=1
	else
		"$py" "$root/scripts/ci/results_guard.py" --repo "$root" --rev "$local_sha" \
			--audit --commits "$local_sha --not --remotes=$remote" >&2 || status=1
	fi
done

if [ "$status" -ne 0 ]; then
	echo "pre-push: refused. Name the record instead of quoting it; a design value goes into" >&2
	echo "          scripts/ci/figure-allowlist.txt with its reason." >&2
fi
exit "$status"
