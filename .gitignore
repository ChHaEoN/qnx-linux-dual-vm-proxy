# This .gitignore is conservative because the QNX NCEULA forbids redistributing
# QNX binaries, IFS images, or compiled QNX components in any form. The patterns
# below exist to make accidental commits of QNX-derived artifacts very hard.

# QNX-derived binaries — NEVER commit
*.bin
*.img
*.vmdk
*.iso
**/ifs*.bin
**/disk-qemu.*
output/
# mkqnximage build trees (QNX-derived guest/host artifacts) — NEVER commit.
# Root-anchored so they do NOT also match scripts/qhv/ (committed source).
/qnx-safety-vm/
/qhv/

# QNX SDP install directories
qnx800/
qnx710/

# Secrets / credentials / cloud
.env
.env.*
!.env.example
*.pem
*.key
.ec2-instance-id
.ec2-*.json
.aws/

# Build artifacts
# ipc-test extensionless QNX binaries (NCEULA: never commit compiled QNX code).
ipc-test/qnx-server/qnx-echo-server
ipc-test/qnx-host-client/qnx-host-client
ipc-test/qnx-server-net/qnx-echo-server-net
ipc-test/qnx-safety-monitor/qnx-safety-monitor
ipc-test/qnx-dds-monitor/qnx-dds-monitor

# Interview / application material: local only, never published (owner,
# 2026-09-20). docs/jd-mapping.md is the sibling case -- CLAUDE.md already
# forbids surfacing it in README. Note this hides the file from the tip only:
# it is present in earlier commits of this public repo.
docs/interview-narrative.md
# idlc-generated sources: regenerated at build time from av.idl, and they carry
# no licence header of their own, so they are not committed.
ipc-test/qnx-dds-monitor/av.c
ipc-test/qnx-dds-monitor/av.h
ipc-test/qnx-host-shmem-probe/hyp-shm-probe
ipc-test/qnx-host-shmem-probe/hyp-shm-roundtrip
ipc-test/qnx-guest-shmem-probe/gshm-probe
# ipc-test extensionless Linux binary (ordinary build artifact, not QNX-derived,
# but still a compiled binary with no reason to be committed).
ipc-test/linux-client/linux-client
*.o
*.a
*.so
*.dylib
*.dll
*.elf
*.efi
*.dtb
*.itb
build/
out/
artifacts/

# Phase 3b board-run record directories: evaluation output under NC QDL v7 4.6(i).
# The curated records and designs live directly under results/orin-native-port/<utc>/,
# never in these per-milestone subdirectories.
results/orin-native-port/*/m3/
results/orin-native-port/*/m4/
results/orin-native-port/*/m5/
results/orin-native-port/*/s1/

# Logs (allow only the curated samples under logs/sample-boot/)
*.log
!logs/sample-boot/*.log
# Curated run records under results/orin-native-port/<utc>/ are evidence, not
# build noise -- the .out files in those directories are already tracked, and a
# blanket *.log silently excluded the guest-side captures that findings.md cites
# (2026-09-18: both the KVM-concurrency and cross-partition-demo consoles).
!results/orin-native-port/*/*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*.code-workspace

# Claude Code: per-user local settings stay out; project-shared subagents go in.
.claude/settings.local.json
.claude/.credentials.json

# Phase 3b (native Orin port) build outputs. The shim source is committed; the
# assembled page and any image concatenated with a QNX IFS are not — the latter
# would carry QNX bytes (NCEULA).
orin-native/shim/out/
orin-native/startup/**/*.o
orin-native/startup/**/*.dep
orin-native/**/startup-t234-orin-nano
*.kimg
# the user-space tools are source here; the built binaries are outputs
orin-native/tools/tcu-cat
orin-native/tools/stamp
orin-native/tools/smpcheck
orin-native/tools/bwait
orin-native/tools/clkcmp
orin-native/tools/trcctl
orin-native/tools/m4count
orin-native/tools/s1con
orin-native/tools/memcanary
orin-native/tools/memcanary-w

# mkifs [+keeplinked] drops symbol files next to the buildfile; they are derived
# from QNX binaries and must never be committed.
*.sym
