{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OneService",
      "Effect": "Allow",
      "Principal": {
        "Service": "firehose.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "@@ACCOUNT@@"
        }
      }
    }
  ]
}
