{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetTheToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullFromTheTwinsRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "@@ECR_REPOSITORIES_ARN@@"
    }
  ]
}
