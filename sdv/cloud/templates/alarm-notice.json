[
  {
    "Key": "errors",
    "AlarmName": "@@ALARM_ERRORS@@",
    "Namespace": "AWS/Lambda",
    "MetricName": "Errors",
    "Dimensions": [
      {
        "Name": "FunctionName",
        "Value": "@@FUNCTION@@"
      }
    ],
    "Statistic": "Sum",
    "Period": 300,
    "EvaluationPeriods": 1,
    "DatapointsToAlarm": 1,
    "ComparisonOperator": "GreaterThanOrEqualToThreshold",
    "Threshold": "@@THRESHOLD_ERRORS@@",
    "TreatMissingData": "notBreaching",
    "ActionsEnabled": true,
    "AlarmActions": "@@NOTICE_ACTIONS@@"
  }
]
